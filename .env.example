# Copiar a .env.local para ajustar valores locales (no se versiona).

# Base de la API que usa el cliente HTTP. Con el proxy de Vite basta la ruta relativa.
VITE_API_BASE_URL=/api/v1

# Backend al que el servidor de desarrollo de Vite reenvía /api.
# Local: http://localhost:8080 · Ambiente develop: https://dev.isoft.lazycat.app
VITE_PROXY_TARGET=http://localhost:8080
